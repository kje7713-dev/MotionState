# MotionState — Object storage (S3 / Cloudflare R2) mode
# Copy to .env and fill in S3/R2 credentials before running.
# Artifacts are stored in S3-compatible object storage instead of the local filesystem.

# Postgres
DATABASE_URL=postgresql+asyncpg://motionstate:motionstate@localhost:5432/motionstate

# Redis
REDIS_URL=redis://localhost:6379/0

# Local staging dirs are still used for uploads/normalized before transfer to S3
UPLOAD_DIR=./data/uploads
NORMALIZED_DIR=./data/normalized
ARTIFACTS_DIR=./data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=false

# Storage backend: s3
STORAGE_BACKEND=s3

# S3 / Cloudflare R2 settings
# For AWS S3:
#   S3_BUCKET=my-bucket
#   S3_REGION=us-east-1
#   S3_ENDPOINT_URL=       (leave empty)
# For Cloudflare R2:
#   S3_BUCKET=my-bucket
#   S3_REGION=auto
#   S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Seconds until a pre-signed upload URL expires (default: 3600 = 1 hour)
SIGNED_URL_EXPIRATION_SECONDS=3600

# Frame extraction
FRAME_SAMPLE_FPS=2.0

DETECTOR_BACKEND=stub
TRACKER_BACKEND=stub
POSE_BACKEND=stub

# API key hashing — use a strong random value in production
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=

# Admin token — set to enable /admin/* endpoints
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
