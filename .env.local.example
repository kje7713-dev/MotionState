# MotionState — Local filesystem mode
# Copy to .env for local development with the default local storage backend.
# All data is written to ./data/* on your local machine.

# Postgres
DATABASE_URL=postgresql+asyncpg://motionstate:motionstate@localhost:5432/motionstate

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage directories (local backend)
UPLOAD_DIR=./data/uploads
NORMALIZED_DIR=./data/normalized
ARTIFACTS_DIR=./data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Storage backend: local (default)
STORAGE_BACKEND=local

# Frame extraction
FRAME_SAMPLE_FPS=2.0

# Backends: stub is the safest default for local dev
DETECTOR_BACKEND=stub
TRACKER_BACKEND=stub
POSE_BACKEND=stub

# API key hashing — change before sharing this environment with others
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=change-me-in-production

# Admin token — set to enable /admin/* endpoints
# Leave empty to disable (safe default for local dev)
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
