# Copy this file to .env and fill in values before running locally.

# Postgres
DATABASE_URL=postgresql+asyncpg://motionstate:motionstate@localhost:5432/motionstate

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./data/uploads
NORMALIZED_DIR=./data/normalized
ARTIFACTS_DIR=./data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Frame extraction
# Number of frames to sample per second of video (default: 2)
FRAME_SAMPLE_FPS=2.0

# Detector
# Use "stub" for no-op (default, no extra dependencies) or "yolo" for YOLOv8.
# Requires: pip install ultralytics
DETECTOR_BACKEND=stub
# YOLOv8 model checkpoint name or path (only used when DETECTOR_BACKEND=yolo)
DETECTOR_MODEL=yolov8n.pt

# Tracker
# Use "stub" for no-op (default) or "iou" for deterministic IOU-based tracking.
# The "iou" backend requires no additional dependencies.
TRACKER_BACKEND=stub
# Minimum IOU overlap to associate a detection with an existing track (iou backend only)
TRACKER_IOU_THRESHOLD=0.3
# Number of frames a track can go undetected before it is dropped (iou backend only)
TRACKER_MAX_AGE=30

# Pose estimator
# Use "stub" for no-op (default) or "mediapipe" for MediaPipe BlazePose.
# Requires: pip install mediapipe pillow numpy  (or: pip install -e ".[pose]")
POSE_BACKEND=stub
# Minimum landmark visibility score to include a keypoint (mediapipe backend only)
POSE_MIN_CONFIDENCE=0.3

# Storage backend
# Use "local" (default, writes to local filesystem) or "s3" (AWS S3 / Cloudflare R2).
# Requires: pip install boto3  (or: pip install -e ".[storage]")  when using "s3"
STORAGE_BACKEND=local

# S3 / Cloudflare R2 settings (only used when STORAGE_BACKEND=s3)
S3_BUCKET=
S3_REGION=auto
# For Cloudflare R2 set this to your R2 endpoint:
#   https://<account-id>.r2.cloudflarestorage.com
# For AWS S3 leave empty to use the default regional endpoint.
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Seconds until a pre-signed upload URL expires (default: 3600 = 1 hour)
SIGNED_URL_EXPIRATION_SECONDS=3600

# API key hashing
# Server-side HMAC secret for API key hashing. Change in production.
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=change-me-in-production

# Admin token for /admin/* endpoints.
# Set to a strong random value to enable the admin API.
# When empty (default) all admin endpoints return 403.
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=
