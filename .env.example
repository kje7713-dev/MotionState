# Copy this file to .env and fill in values before running locally.

# Postgres
DATABASE_URL=postgresql+asyncpg://motionstate:motionstate@localhost:5432/motionstate

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./data/uploads
NORMALIZED_DIR=./data/normalized
ARTIFACTS_DIR=./data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Frame extraction
# Number of frames to sample per second of video (default: 2)
FRAME_SAMPLE_FPS=2.0

# Detector
# Use "stub" for no-op (default, no extra dependencies) or "yolo" for YOLOv8.
# Requires: pip install ultralytics
DETECTOR_BACKEND=stub
# YOLOv8 model checkpoint name or path (only used when DETECTOR_BACKEND=yolo)
DETECTOR_MODEL=yolov8n.pt
