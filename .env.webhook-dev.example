# MotionState — Webhook development mode
# Copy to .env when developing or testing webhook integrations locally.
# Uses local storage and includes webhook-specific guidance.

# Postgres
DATABASE_URL=postgresql+asyncpg://motionstate:motionstate@localhost:5432/motionstate

# Redis
REDIS_URL=redis://localhost:6379/0

# Storage
UPLOAD_DIR=./data/uploads
NORMALIZED_DIR=./data/normalized
ARTIFACTS_DIR=./data/artifacts

# API
API_HOST=0.0.0.0
API_PORT=8000
DEBUG=true

# Storage backend: local
STORAGE_BACKEND=local

# Frame extraction
FRAME_SAMPLE_FPS=2.0

DETECTOR_BACKEND=stub
TRACKER_BACKEND=stub
POSE_BACKEND=stub

# API key hashing
# Generate with: openssl rand -hex 32
API_KEY_HMAC_SECRET=change-me-in-production

# Admin token — set to enable /admin/* endpoints
# Generate with: openssl rand -hex 32
ADMIN_TOKEN=

# --- Webhook development tips ---
#
# 1. Register a webhook endpoint:
#    curl -X POST "http://localhost:8000/projects/1/webhooks" \
#         -H "Content-Type: application/json" \
#         -d '{"url": "https://your-ngrok-url.ngrok.io/webhooks"}'
#
# 2. Use a local tunnel (ngrok, localtunnel, etc.) to receive webhooks:
#    ngrok http 8000
#
# 3. Verify webhook signatures using the secret returned at endpoint creation:
#    import hashlib, hmac
#    expected = hmac.new(secret.encode(), raw_body, hashlib.sha256).hexdigest()
#
# 4. Supported event types:
#    - processing_run.created
#    - processing_run.running
#    - processing_run.completed
#    - processing_run.failed
